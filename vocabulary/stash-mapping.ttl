sem:map_timeline a sem:Mapping ;
    rdfs:comment "Also produces sem:Slot, sem:Stage, sem:StagePick, and the media-level sem:MiseEnSceneInstance." ;
    sem:fromEntity "Scene, Image" ;
    sem:fromField "custom_fields.timeline" ;
    sem:allowedValues "ordered JSON list of entries; an entry with type 'stage' is a Stage, any other entry is a slot" ;
    sem:produces sem:Timeline ;
    sem:source "README.md § Features (Timeline); src/ui/timeline.js (read as implementation evidence, documents win)" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Active ;
    sem:since "1.0.0" .

sem:map_performerTags a sem:Mapping ;
    rdfs:comment "Also produces sem:hasLabel and sem:hasPerformerVariation, by the tag's flag." ;
    sem:fromEntity "Performer" ;
    sem:fromField "tags" ;
    sem:allowedValues "Stash tags flagged isTrait, isLabel, or isVariation" ;
    sem:produces sem:hasTrait ;
    sem:source "semantic-query-engine-roadmap.md § Core Design Decisions 2 (semantic graph) and Vocabulary corrections" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Active ;
    sem:since "1.0.0" .

sem:map_tagParents a sem:Mapping ;
    rdfs:comment "A parent with the same type flag (a Role under a Role, a Relation under a Relation) also produces sem:broaderRole or sem:broaderRelation (since 1.2.0)." ;
    sem:fromEntity "Tag" ;
    sem:fromField "parents" ;
    sem:allowedValues "Stash tag ids; direct parents only" ;
    sem:produces sem:parentTag ;
    sem:source "semantic-query-engine-roadmap.md § Core Design Decisions 2 (semantic graph) and Vocabulary corrections" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Active ;
    sem:since "1.0.0" .

sem:map_isRelation a sem:Mapping ;
    sem:fromEntity "Tag" ;
    sem:fromField "custom_fields.isRelation" ;
    sem:allowedValues "1 (stored as a 0/1 value; other values mean not set)" ;
    sem:produces sem:Relation ;
    sem:source "specs/004-relations-role-hierarchy/spec.md (owner, 2026-10-21)" ;
    sem:sourceRevision "owner request 2026-10-21; not in the plugin documents at 3c82c85" ;
    sem:status sem:Active ;
    sem:since "1.2.0" .

sem:map_relationEnds a sem:Mapping ;
    rdfs:comment "Also produces sem:endBRole." ;
    sem:fromEntity "Tag" ;
    sem:fromField "custom_fields.relationEnds" ;
    sem:allowedValues "JSON {\"a\": roleTagId, \"b\": roleTagId}" ;
    sem:produces sem:endARole ;
    sem:source "specs/004-relations-role-hierarchy/spec.md (owner, 2026-10-21)" ;
    sem:sourceRevision "owner request 2026-10-21; not in the plugin documents at 3c82c85" ;
    sem:status sem:Active ;
    sem:since "1.2.0" .

sem:map_relationRules a sem:Mapping ;
    sem:fromEntity "Tag" ;
    sem:fromField "custom_fields.relationRules" ;
    sem:allowedValues "JSON list of {id, a: {label | role}, b: {label | role}, actions?}" ;
    sem:produces sem:RelationRule ;
    sem:source "specs/004-relations-role-hierarchy/spec.md (owner, 2026-10-21)" ;
    sem:sourceRevision "owner request 2026-10-21; not in the plugin documents at 3c82c85" ;
    sem:status sem:Active ;
    sem:since "1.2.0" .

sem:map_relationAssignments a sem:Mapping ;
    sem:fromEntity "Scene, Image" ;
    sem:fromField "custom_fields.relationAssignments" ;
    sem:allowedValues "JSON list of {relationTagId, a, b, auto?, ruleId?}" ;
