sem:map_plugtag a sem:Mapping ;
    sem:fromEntity "Tag" ;
    sem:fromField "custom_fields.plugtag" ;
    sem:allowedValues "1 (stored as a 0/1 value; other values mean not set)" ;
    sem:produces sem:Pluggable ;
    sem:source "README.md § Features" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Active ;
    sem:since "1.0.0" .

