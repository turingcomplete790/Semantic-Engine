sem:map_variationData a sem:Mapping ;
    rdfs:comment "Also produces sem:hasVariationLabel and sem:variationOf from the same value." ;
    sem:fromEntity "Tag (Variation)" ;
    sem:fromField "custom_fields.variationData" ;
    sem:allowedValues "JSON object {performerId, pluggableTagIds, traitTagIds, labelTagIds}; the vocabulary exposes performerId, pluggableTagIds, and labelTagIds" ;
    sem:produces sem:hasVariationPluggable ;
    sem:source "semantic-query-engine-roadmap.md § Milestone 1D (Variation System & Label Overhaul)" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Active ;
    sem:since "1.0.0" .

