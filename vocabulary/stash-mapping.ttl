    sem:sourceRevision "owner request 2026-10-21; not in the plugin documents at 3c82c85" ;
    sem:status sem:Active ;
    sem:since "1.2.0" .

sem:map_autoRoleAssignments a sem:Mapping ;
    rdfs:comment "Marks which Role assignments auto-apply added as relation end roles; the same roles also appear in roleTagAssignments." ;
    sem:fromEntity "Scene, Image" ;
    sem:fromField "custom_fields.autoRoleAssignments" ;
    sem:allowedValues "JSON map of performer id to the Role tag ids auto-apply added" ;
    sem:produces sem:RoleInstance ;
    sem:source "specs/004-relations-role-hierarchy/spec.md (owner, 2026-10-21)" ;
    sem:sourceRevision "owner request 2026-10-21; not in the plugin documents at 3c82c85" ;
    sem:status sem:Active ;
    sem:since "1.2.0" .

sem:map_serverId a sem:Mapping ;
    rdfs:comment "Planned: generated once by an engine-plugin task and stored in Stash." ;
    sem:fromEntity "Stash server" ;
    sem:fromField "plugin setting serverId of the engine plugin (exact name fixed by the engine feature)" ;
    sem:allowedValues "lower-case hyphenated UUID" ;
    sem:produces sem:serverIdentifier ;
    sem:source "specs/001-semantic-vocabulary/spec.md § FR-014" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Planned ;
    sem:since "1.0.0" .

# ---- Retired fields: recorded, never mapped to a term (FR-016)

sem:retired_isGeneric a sem:RetiredField ;
    sem:fromEntity "Performer" ;
    sem:fromField "custom_fields.isGeneric" ;
    sem:retiredNote "Generics are replaced by Archetypes; existing data is left in place and not read." ;
    sem:replacedBy sem:Archetype ;
    sem:source "semantic-query-engine-roadmap.md § Core Design Decisions 2 (semantic graph) and Vocabulary corrections" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Deprecated ;
    sem:since "1.0.0" .

sem:retired_looks a sem:RetiredField ;
    sem:fromEntity "Performer" ;
    sem:fromField "custom_fields.looks" ;
    sem:retiredNote "Looks stored as JSON are replaced by Variation tags; not read." ;
    sem:replacedBy sem:Variation ;
    sem:source "semantic-query-engine-roadmap.md § Milestone 1D (Variation System & Label Overhaul)" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Deprecated ;
    sem:since "1.0.0" .

sem:retired_legacyMiseRef a sem:RetiredField ;
    sem:fromEntity "Scene, Image" ;
    sem:fromField "custom_fields.timeline[*].ref (kind 'mise-en-scene')" ;
    sem:retiredNote "Per-slot Mise-en-scène refs are superseded by Stage picks; not read." ;
    sem:replacedBy sem:StagePick ;
    sem:source "src/ui/timeline.js (read as implementation evidence, documents win)" ;
    sem:sourceRevision "3c82c85 plus working copy, read 2026-10-14" ;
    sem:status sem:Deprecated ;
    sem:since "1.0.0" .

sem:map_fieldMapping a sem:Mapping ;
    sem:fromEntity "Tag (Trait, Label, Variation)" ;
    sem:fromField "custom_fields.fieldMapping" ;
    sem:allowedValues "JSON {base?: {field, priority}, variations?: {\"<variation>\": {field, priority}}}; Labels and Variations use base only" ;
    sem:produces sem:FieldMappingRule ;
    sem:source "semantic-query-engine-roadmap.md § Milestone 1D (Field Mapping); src/ui/field-mapping.js" ;
    sem:sourceRevision "2c04141, read 2026-10-24" ;
    sem:status sem:Active ;
    sem:since "1.3.0" .

sem:map_measurements a sem:Mapping ;
    sem:fromEntity "Performer" ;
    sem:fromField "measurements" ;
    sem:allowedValues "free text such as 34D-26-35; derived as in spec 005 FR-002b" ;
    sem:produces sem:bustSize ;
    rdfs:comment "Also produces sem:waist, sem:hip and sem:waistToHipRatio. A value that cannot be derived is absent." ;
    sem:source "src/ui/matrix.js parseMeasurements, DERIVED_PERFORMER_FIELDS (not in the design documents)" ;
    sem:sourceRevision "2c04141, read 2026-10-24" ;
    sem:status sem:Active ;
    sem:since "1.3.0" .
