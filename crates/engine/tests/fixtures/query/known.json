[
  {
    "name": "role-short-form",
    "query": "SELECT ?scene WHERE { ?scene :hasPerformer ?p . ?p :hasRole :Dom }",
    "expected": [
      {
        "scene": "i:scene:100"
      },
      {
        "scene": "i:scene:101"
      },
      {
        "scene": "i:image:200"
      }
    ],
    "because": "Dom is tag 2; role instances 100/role:7:2, 101/role:9:2, 200/role:8:2, each performer on its media"
  },
  {
    "name": "role-with-performer",
    "query": "SELECT ?scene ?p WHERE { ?scene :hasPerformer ?p . ?p :hasRole :Sub }",
    "expected": [
      {
        "scene": "i:scene:100",
        "p": "i:performer:8"
      },
      {
        "scene": "i:scene:101",
        "p": "i:performer:7"
      },
      {
        "scene": "i:scene:301",
        "p": "i:performer:8"
      }
    ],
    "because": "Sub is tag 3: 100/role:8:3, 101/role:7:3, 301/role:8:3"
  },
  {
    "name": "multiple-bound-performers",
    "query": "SELECT ?scene ?dom ?sub WHERE {\n  ?scene :hasPerformer ?dom .\n  ?scene :hasPerformer ?sub .\n  ?dom :hasRole :Dom .\n  ?sub :hasRole :Sub .\n  FILTER (?dom != ?sub)\n}",
    "expected": [
      {
        "scene": "i:scene:100",
        "dom": "i:performer:7",
        "sub": "i:performer:8"
      },
      {
        "scene": "i:scene:101",
        "dom": "i:performer:9",
        "sub": "i:performer:7"
      }
    ],
    "because": "the documents' example: 100 has Dom 7 and Sub 8; 101 has Dom 9 and Sub 7"
  },
  {
    "name": "no-cross-scene-match",
    "query": "SELECT ?scene ?p WHERE { ?scene :hasPerformer ?p . ?p :hasRole :Dom . ?p :hasRole :Sub }",
    "expected": [],
    "because": "performer 7 is Dom in 100 and Sub in 101, never both in one scene"
  },
