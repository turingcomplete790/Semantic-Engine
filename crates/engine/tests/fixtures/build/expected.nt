i:scene:301/pairing:q2 sem:inMedia i:scene:301 .
i:scene:301/pairing:q2 sem:pairingId "q2" .
i:scene:301/pairing:q2 sem:pairsA i:scene:301/action:9:4 .
i:scene:301/pairing:q2 sem:pairsB i:scene:301/action:9:4 .

# Timeline: t1 (unknown kind), t2 (retired ref) and the entry with no id are skipped. Slot t5
# names the skipped pairing q1, so it keeps its own facts without places.
i:scene:301 sem:hasTimeline i:scene:301/timeline .
i:scene:301/timeline a sem:Timeline .
i:scene:301/timeline sem:inMedia i:scene:301 .
i:scene:301/timeline sem:hasEntry i:scene:301/timeline/t4 .
i:scene:301/timeline/t4 a sem:Slot .
i:scene:301/timeline/t4 sem:position "3"^^xsd:nonNegativeInteger .
i:scene:301/timeline/t4 sem:entryId "t4" .
i:scene:301/timeline/t4 sem:slotSeconds "12"^^xsd:decimal .
i:scene:301/timeline/t4 sem:places i:scene:301/role:8:3 .
i:scene:301/timeline sem:hasEntry i:scene:301/timeline/t5 .
i:scene:301/timeline/t5 a sem:Slot .
i:scene:301/timeline/t5 sem:position "4"^^xsd:nonNegativeInteger .
i:scene:301/timeline/t5 sem:entryId "t5" .

# ---- Scene 302: every semantic field unreadable; still a media entity with its performer
i:scene:302 a sem:Scene .
i:scene:302 sem:hasPerformer i:performer:8 .
